<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="ConstructionToolbar.uss" />

    <ui:VisualElement
        name="construction-toolbar-screen"
        class="construction-toolbar-screen"
        picking-mode="Ignore">

        <ui:VisualElement
            name="store-cash-hud"
            class="store-cash-hud"
            picking-mode="Ignore">

            <ui:Label
                text="STORE CASH"
                class="store-cash-hud__caption"
                picking-mode="Ignore" />

            <ui:Label
                name="store-cash-value"
                text="$0.00"
                class="store-cash-hud__value"
                picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement
            name="simulation-clock"
            class="simulation-clock"
            picking-mode="Position">

            <ui:VisualElement
                class="simulation-clock__readout"
                picking-mode="Ignore">
                <ui:Label
                    name="simulation-clock-day"
                    text="MONDAY  •  DAY 1"
                    class="simulation-clock__day"
                    picking-mode="Ignore" />
                <ui:Label
                    name="simulation-clock-time"
                    text="8:00 AM"
                    class="simulation-clock__time"
                    picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement
                class="simulation-clock__speeds"
                picking-mode="Position">
                <ui:Button
                    name="simulation-speed-pause"
                    text="Ⅱ"
                    class="simulation-clock__speed"
                    tooltip="Pause simulation time." />
                <ui:Button
                    name="simulation-speed-one"
                    text="1×"
                    class="simulation-clock__speed is-selected"
                    tooltip="Run at normal speed." />
                <ui:Button
                    name="simulation-speed-two"
                    text="2×"
                    class="simulation-clock__speed"
                    tooltip="Run at double speed." />
                <ui:Button
                    name="simulation-speed-four"
                    text="4×"
                    class="simulation-clock__speed"
                    tooltip="Run at quadruple speed." />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="department-picker"
            class="department-picker"
            picking-mode="Position">

            <ui:Label
                text="Departments"
                class="department-picker__title"
                picking-mode="Ignore" />

            <ui:VisualElement
                name="department-picker-items"
                class="department-picker__items"
                picking-mode="Position" />
        </ui:VisualElement>

        <ui:VisualElement
            name="fixture-merchandising-inspector"
            class="fixture-merchandising-inspector"
            picking-mode="Position">

            <ui:VisualElement
                class="fixture-merchandising-inspector__header"
                picking-mode="Position">

                <ui:Label
                    name="fixture-merchandising-title"
                    text="Fixture"
                    class="fixture-merchandising-inspector__title"
                    picking-mode="Ignore" />

                <ui:Button
                    name="fixture-merchandising-close-button"
                    text="X"
                    class="fixture-merchandising-inspector__close-button"
                    tooltip="Close fixture inspector." />
            </ui:VisualElement>

            <ui:Label
                name="fixture-merchandising-status"
                text="Fixture planogram."
                class="fixture-merchandising-inspector__status"
                picking-mode="Ignore" />

            <ui:VisualElement
                name="fixture-merchandising-overview"
                class="fixture-merchandising-inspector__overview"
                picking-mode="Position">

                <ui:Label
                    text="Department / zone: not connected"
                    class="fixture-merchandising-inspector__subtitle"
                    picking-mode="Ignore" />

                <ui:Label
                    text="DISPLAY INVENTORY ACTIVE  -  JOBS / SALES NOT CONNECTED"
                    class="fixture-merchandising-inspector__preview-badge"
                    picking-mode="Ignore" />

                <ui:VisualElement
                    class="fixture-merchandising-inspector__summary"
                    picking-mode="Ignore">

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row fixture-merchandising-inspector__summary-row--live">
                        <ui:Label
                            text="Planogram"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-merchandising-planogram-value"
                            text="0 / 0 assigned"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row fixture-merchandising-inspector__summary-row--live">
                        <ui:Label
                            text="Products"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-merchandising-products-value"
                            text="0 products"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Shelf stock"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-merchandising-shelf-stock-value"
                            text="0 / 0 units"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Backstock"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-merchandising-backstock-value"
                            text="0 units available"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Sales today"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-merchandising-sales-today-value"
                            text="--"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Restock status"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-merchandising-restock-status-value"
                            text="Awaiting planogram"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement
                    class="fixture-merchandising-inspector__action-row"
                    picking-mode="Position">

                    <ui:Button
                        name="fixture-merchandising-edit-button"
                        text="Edit Products"
                        class="fixture-merchandising-inspector__primary-button fixture-merchandising-inspector__action-button" />

                    <ui:Button
                        name="fixture-merchandising-restock-button"
                        text="Restock Now"
                        class="fixture-merchandising-inspector__secondary-button fixture-merchandising-inspector__action-button"
                        tooltip="Move matching backstock directly onto this fixture." />
                </ui:VisualElement>

                <ui:VisualElement
                    class="fixture-merchandising-inspector__automation-row"
                    picking-mode="Position">

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__automation-copy"
                        picking-mode="Ignore">
                        <ui:Label
                            text="Auto Restock"
                            class="fixture-merchandising-inspector__automation-title" />
                        <ui:Label
                            text="Requires inventory and worker jobs"
                            class="fixture-merchandising-inspector__automation-note" />
                    </ui:VisualElement>

                    <ui:Button
                        name="fixture-merchandising-auto-restock-button"
                        text="Not Connected"
                        class="fixture-merchandising-inspector__automation-button"
                        tooltip="Auto Restock is a future operations hookup." />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement
                name="fixture-storage-overview"
                class="fixture-merchandising-inspector__storage-overview"
                picking-mode="Position">

                <ui:ScrollView
                    name="fixture-storage-scroll"
                    class="fixture-merchandising-inspector__storage-scroll"
                    horizontal-scroller-visibility="Hidden"
                    vertical-scroller-visibility="Auto">

                <ui:Label
                    text="Physical backstock rack"
                    class="fixture-merchandising-inspector__subtitle"
                    picking-mode="Ignore" />

                <ui:Label
                    text="RACK INVENTORY + RECEIVING ACTIVE  -  CASH / WORKERS NOT CONNECTED"
                    class="fixture-merchandising-inspector__preview-badge"
                    picking-mode="Ignore" />

                <ui:Label
                    text="Stock is assigned to this rack. Received cases are distributed automatically; excess waits in inbound / overflow."
                    class="fixture-merchandising-inspector__storage-note"
                    picking-mode="Ignore" />

                <ui:VisualElement
                    class="fixture-merchandising-inspector__summary"
                    picking-mode="Ignore">

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row fixture-merchandising-inspector__summary-row--live">
                        <ui:Label
                            text="This rack"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-storage-rack-capacity-value"
                            text="0 / 0 units"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row fixture-merchandising-inspector__summary-row--live">
                        <ui:Label
                            text="Store capacity"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-storage-total-capacity-value"
                            text="0 units"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Stored"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-storage-stored-value"
                            text="0 / 0 units"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Inbound / overflow"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-storage-unallocated-value"
                            text="0 units"
                            class="fixture-merchandising-inspector__summary-value" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Free space"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-storage-free-space-value"
                            text="0 units"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__summary-row">
                        <ui:Label
                            text="Storage status"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-storage-status-value"
                            text="Unavailable"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--live" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label
                    text="This rack contains"
                    class="fixture-merchandising-inspector__subtitle"
                    picking-mode="Ignore" />

                <ui:VisualElement
                    name="fixture-storage-contents"
                    class="fixture-merchandising-inspector__storage-contents"
                    picking-mode="Ignore">
                    <ui:Label
                        text="Empty"
                        class="fixture-merchandising-inspector__storage-empty"
                        picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement
                    class="fixture-merchandising-inspector__purchasing"
                    picking-mode="Position">

                    <ui:Label
                        text="Supplier Deliveries"
                        class="fixture-merchandising-inspector__subtitle"
                        picking-mode="Ignore" />

                    <ui:Label
                        text="Purchase orders arrive on the supplier schedule. Receive arrived deliveries into store storage here."
                        class="fixture-merchandising-inspector__purchasing-note"
                        picking-mode="Ignore" />

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__purchasing-summary fixture-merchandising-inspector__purchasing-summary--cash"
                        picking-mode="Ignore">
                        <ui:Label
                            text="Available cash"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-purchasing-cash-value"
                            text="$0.00"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--cash" />
                    </ui:VisualElement>

                    <ui:VisualElement
                        name="fixture-purchasing-products"
                        class="fixture-merchandising-inspector__purchasing-products"
                        picking-mode="Position" />

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__purchasing-summary"
                        picking-mode="Ignore">
                        <ui:Label
                            text="Ready at receiving"
                            class="fixture-merchandising-inspector__summary-label" />
                        <ui:Label
                            name="fixture-purchasing-pending-value"
                            text="Nothing ready to receive"
                            class="fixture-merchandising-inspector__summary-value fixture-merchandising-inspector__summary-value--pending" />
                    </ui:VisualElement>

                    <ui:Button
                        name="fixture-purchasing-receive-button"
                        text="Receive Supplier Pallets"
                        class="fixture-merchandising-inspector__receive-button"
                        tooltip="Move every arrived supplier delivery into store inventory." />

                    <ui:Label
                        name="fixture-purchasing-status"
                        text="Place purchase orders to schedule supplier deliveries."
                        class="fixture-merchandising-inspector__purchasing-status"
                        picking-mode="Ignore" />
                </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement
                name="fixture-merchandising-editing"
                class="fixture-merchandising-inspector__editing"
                picking-mode="Position">

                <ui:Label
                    name="fixture-merchandising-shelf"
                    text="Choose a shelf slot"
                    class="fixture-merchandising-inspector__shelf-label"
                    picking-mode="Ignore" />

                <ui:Label
                    text="Light = empty  |  Gold = selected  |  Product color = assigned"
                    class="fixture-merchandising-inspector__color-legend"
                    picking-mode="Ignore" />

                <ui:VisualElement
                    name="fixture-merchandising-frontage-controls"
                    class="fixture-merchandising-inspector__frontage-controls"
                    picking-mode="Position">

                    <ui:VisualElement
                        name="fixture-merchandising-products"
                        class="fixture-merchandising-inspector__products"
                        picking-mode="Position" />

                    <ui:VisualElement
                        class="fixture-merchandising-inspector__width-row"
                        picking-mode="Position">

                        <ui:Button
                            name="fixture-merchandising-width-decrease"
                            text="-"
                            class="fixture-merchandising-inspector__step-button"
                            tooltip="Use one fewer shelf slot." />

                        <ui:Label
                            name="fixture-merchandising-width"
                            text="Width: 1 of 4 slots"
                            class="fixture-merchandising-inspector__width-label"
                            picking-mode="Ignore" />

                        <ui:Button
                            name="fixture-merchandising-width-increase"
                            text="+"
                            class="fixture-merchandising-inspector__step-button"
                            tooltip="Use one more shelf slot." />
                    </ui:VisualElement>

                    <ui:Button
                        name="fixture-merchandising-clear-button"
                        text="Clear Product"
                        class="fixture-merchandising-inspector__secondary-button" />
                </ui:VisualElement>

                <ui:Button
                    name="fixture-merchandising-done-button"
                    text="Done"
                    class="fixture-merchandising-inspector__primary-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="foundation-picker"
            class="finish-picker"
            picking-mode="Position">

            <ui:Label
                text="Foundations"
                class="finish-picker__title"
                picking-mode="Ignore" />

            <ui:VisualElement
                class="finish-picker__items"
                picking-mode="Position">

                <ui:Button
                    name="foundation-default-button"
                    class="finish-picker__button"
                    tooltip="Build standard foundation tiles.">
                    <ui:VisualElement
                        class="finish-picker__icon foundation-picker__icon--default"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="sidewalks-button"
                    class="finish-picker__button"
                    tooltip="Build sidewalk tiles inside the lot.">
                    <ui:VisualElement
                        class="finish-picker__icon foundation-picker__icon--sidewalks"
                        picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="wall-finish-picker"
            class="finish-picker"
            picking-mode="Position">

            <ui:Label
                text="Wall finishes"
                class="finish-picker__title"
                picking-mode="Ignore" />

            <ui:VisualElement
                name="wall-finish-picker-items"
                class="finish-picker__items"
                picking-mode="Position" />
        </ui:VisualElement>

        <ui:VisualElement
            name="floor-finish-picker"
            class="finish-picker"
            picking-mode="Position">

            <ui:Label
                text="Floor finishes"
                class="finish-picker__title"
                picking-mode="Ignore" />

            <ui:VisualElement
                name="floor-finish-picker-items"
                class="finish-picker__items"
                picking-mode="Position" />
        </ui:VisualElement>

        <ui:VisualElement
            name="door-definition-picker"
            class="finish-picker"
            picking-mode="Position">

            <ui:Label
                text="Doors"
                class="finish-picker__title"
                picking-mode="Ignore" />

            <ui:VisualElement
                name="door-definition-picker-items"
                class="finish-picker__items"
                picking-mode="Position">

                <ui:Button
                    name="windows-button"
                    class="finish-picker__button"
                    tooltip="Place a fixed window on an existing wall.">
                    <ui:VisualElement
                        class="finish-picker__icon finish-picker__icon--windows"
                        picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="fixture-definition-picker"
            class="finish-picker"
            picking-mode="Position">

            <ui:Label
                text="Fixtures"
                class="finish-picker__title"
                picking-mode="Ignore" />

            <ui:VisualElement
                class="fixture-picker__content"
                picking-mode="Position">

                <ui:VisualElement
                    name="fixture-definition-picker-items"
                    class="finish-picker__items"
                    picking-mode="Position" />

                <ui:Button
                    name="fixture-rotate-button"
                    text="↻"
                    class="fixture-picker__rotate-button"
                    tooltip="Rotate the selected fixture clockwise (R)." />
            </ui:VisualElement>

            <ui:Label
                name="fixture-equipment-selected"
                text="Selected fixture"
                class="fixture-equipment__selected"
                picking-mode="Ignore" />

            <ui:Label
                name="fixture-equipment-summary"
                text="OWNED 0 · PLANNED 0 · ORDERED 0"
                class="fixture-equipment__summary"
                picking-mode="Ignore" />

            <ui:VisualElement
                class="fixture-equipment__actions"
                picking-mode="Position">

                <ui:Button
                    name="fixture-plan-mode-button"
                    text="PLAN LAYOUT"
                    class="fixture-equipment__button" />

                <ui:Button
                    name="fixture-order-plans-button"
                    text="EQUIPMENT CATALOG"
                    class="fixture-equipment__button fixture-equipment__button--primary" />

                <ui:Button
                    name="fixture-install-plans-button"
                    text="INSTALL READY"
                    class="fixture-equipment__button" />
            </ui:VisualElement>

            <ui:Label
                name="fixture-equipment-status"
                text="Plan freely, then order the equipment your layout needs."
                class="fixture-equipment__status"
                picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement
            name="demolition-picker"
            class="demolition-picker"
            picking-mode="Position">

            <ui:Label
                text="Demolish"
                class="demolition-picker__title"
                picking-mode="Ignore" />

            <ui:VisualElement
                class="demolition-picker__items"
                picking-mode="Position">

                <ui:Button
                    name="demolish-foundations-button"
                    class="demolition-picker__button"
                    tooltip="Remove foundation tiles from the lot.">
                    <ui:VisualElement
                        class="demolition-picker__icon demolition-picker__icon--foundations"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="demolish-sidewalks-button"
                    class="demolition-picker__button"
                    tooltip="Remove sidewalk tiles from the lot.">
                    <ui:VisualElement
                        class="demolition-picker__icon demolition-picker__icon--sidewalks"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="demolish-floors-button"
                    class="demolition-picker__button"
                    tooltip="Remove finished flooring from foundation.">
                    <ui:VisualElement
                        class="demolition-picker__icon demolition-picker__icon--floors"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="demolish-walls-button"
                    class="demolition-picker__button"
                    tooltip="Remove walls, doors, and windows.">
                    <ui:VisualElement
                        class="demolition-picker__icon demolition-picker__icon--walls"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="demolish-fixtures-button"
                    class="demolition-picker__button"
                    tooltip="Remove retail fixtures from the store.">
                    <ui:VisualElement
                        class="demolition-picker__icon demolition-picker__icon--fixtures"
                        picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="view-controls"
            class="view-controls"
            picking-mode="Position">

            <ui:VisualElement
                name="camera-rotation-controls"
                class="camera-rotation-controls"
                picking-mode="Position">

                <ui:Button
                    name="camera-view-west-button"
                    class="camera-rotation-controls__button"
                    tooltip="View from the west.">
                    <ui:VisualElement
                        class="camera-rotation-controls__icon camera-rotation-controls__icon--west"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="camera-view-north-button"
                    class="camera-rotation-controls__button is-selected"
                    tooltip="View from the north.">
                    <ui:VisualElement
                        class="camera-rotation-controls__icon camera-rotation-controls__icon--north"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="camera-view-south-button"
                    class="camera-rotation-controls__button"
                    tooltip="View from the south.">
                    <ui:VisualElement
                        class="camera-rotation-controls__icon camera-rotation-controls__icon--south"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="camera-view-east-button"
                    class="camera-rotation-controls__button"
                    tooltip="View from the east.">
                    <ui:VisualElement
                        class="camera-rotation-controls__icon camera-rotation-controls__icon--east"
                        picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement
                name="wall-view-controls"
                class="wall-view-controls"
                picking-mode="Position">

                <ui:Button
                    name="wall-view-down-button"
                    class="wall-view-controls__button"
                    tooltip="Walls down: show every wall at base height.">
                    <ui:VisualElement
                        class="wall-view-controls__icon wall-view-controls__icon--down"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="wall-view-cutaway-button"
                    class="wall-view-controls__button"
                    tooltip="Cutaway: lower walls that block constructed foundation.">
                    <ui:VisualElement
                        class="wall-view-controls__icon wall-view-controls__icon--cutaway"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="wall-view-up-button"
                    class="wall-view-controls__button is-selected"
                    tooltip="Walls up: show every wall at full height.">
                    <ui:VisualElement
                        class="wall-view-controls__icon wall-view-controls__icon--up"
                        picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button
            name="departments-button"
            class="construction-toolbar__button departments-button"
            tooltip="Paint and manage department zones.">
            <ui:VisualElement
                class="construction-toolbar__icon construction-toolbar__icon--departments"
                picking-mode="Ignore" />
        </ui:Button>

        <ui:Button
            name="merchandise-tool-button"
            class="construction-toolbar__button merchandise-tool-button"
            tooltip="Inspect a fixture and edit its product planogram.">
            <ui:VisualElement
                class="construction-toolbar__icon construction-toolbar__icon--departments"
                picking-mode="Ignore" />
        </ui:Button>

        <ui:Button
            name="purchasing-button"
            class="construction-toolbar__button purchasing-button"
            tooltip="Review suppliers and place purchase orders.">
            <ui:Label
                text="PO"
                class="construction-toolbar__text-icon"
                picking-mode="Ignore" />
        </ui:Button>

        <ui:Button
            name="equipment-catalog-button"
            class="construction-toolbar__button equipment-catalog-button"
            tooltip="Browse and order physical store equipment.">
            <ui:Label
                text="EQP"
                class="construction-toolbar__text-icon equipment-catalog-button__label"
                picking-mode="Ignore" />
        </ui:Button>

        <ui:Button
            name="receiving-area-button"
            class="construction-toolbar__button receiving-area-button"
            tooltip="Paint receiving space for incoming deliveries.">
            <ui:Label
                text="RCV"
                class="construction-toolbar__text-icon receiving-area-button__label"
                picking-mode="Ignore" />
        </ui:Button>

        <ui:VisualElement
            name="receiving-area-panel"
            class="receiving-area-panel"
            picking-mode="Position">

            <ui:Label
                text="RECEIVING AREA"
                class="receiving-area-panel__title"
                picking-mode="Ignore" />

            <ui:Label
                name="receiving-area-capacity"
                text="NO RECEIVING SPACE"
                class="receiving-area-panel__capacity"
                picking-mode="Ignore" />

            <ui:Label
                name="receiving-area-instruction"
                text="Drag on finished floor to add. Start on Receiving space to erase."
                class="receiving-area-panel__instruction"
                picking-mode="Ignore" />

            <ui:Label
                name="receiving-equipment-status"
                text="NO BIG EQUIPMENT PALLETS STAGED"
                class="receiving-area-panel__equipment-status"
                picking-mode="Ignore" />

            <ui:Button
                name="receiving-equipment-button"
                text="RECEIVE BIG EQUIPMENT"
                class="receiving-area-panel__equipment-button" />
        </ui:VisualElement>

        <ui:VisualElement
            name="construction-toolbar"
            class="construction-toolbar"
            picking-mode="Position">

            <ui:VisualElement
                name="construction-tool-group"
                class="construction-toolbar__group">

                <ui:Button
                    name="foundations-button"
                    class="construction-toolbar__button"
                    tooltip="Build foundations or sidewalks.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--foundations"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="floors-button"
                    class="construction-toolbar__button"
                    tooltip="Paint a floor finish on existing foundation.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--floors"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="walls-button"
                    class="construction-toolbar__button"
                    tooltip="Draw walls and choose their finish.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--walls"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="doors-button"
                    class="construction-toolbar__button"
                    tooltip="Place doors or windows on existing walls.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--doors"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="fixtures-button"
                    class="construction-toolbar__button"
                    tooltip="Place and rotate retail fixtures.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--fixtures"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="demolition-button"
                    class="construction-toolbar__button"
                    tooltip="Choose a construction type to remove.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--demolition"
                        picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement
                name="construction-history-separator"
                class="construction-toolbar__separator"
                picking-mode="Ignore" />

            <ui:VisualElement
                name="construction-history-group"
                class="construction-toolbar__group">

                <ui:Button
                    name="undo-button"
                    class="construction-toolbar__button construction-toolbar__button--history"
                    tooltip="Undo the most recent construction action.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--undo"
                        picking-mode="Ignore" />
                </ui:Button>

                <ui:Button
                    name="redo-button"
                    class="construction-toolbar__button construction-toolbar__button--history"
                    tooltip="Restore the most recently undone construction action.">
                    <ui:VisualElement
                        class="construction-toolbar__icon construction-toolbar__icon--redo"
                        picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="campaign-objective-card"
            class="campaign-objective-card"
            picking-mode="Ignore">

            <ui:Label
                text="CURRENT OBJECTIVE"
                class="campaign-objective-card__caption"
                picking-mode="Ignore" />

            <ui:Label
                name="campaign-objective-title"
                text="Make It a Store"
                class="campaign-objective-card__title"
                picking-mode="Ignore" />

            <ui:Label
                name="campaign-objective-description"
                text="Build a store shell with an entrance and room for merchandise."
                class="campaign-objective-card__description"
                picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement
            name="campaign-opening-overlay"
            class="campaign-opening-overlay"
            picking-mode="Position">

            <ui:VisualElement
                class="campaign-opening-panel"
                picking-mode="Position">

                <ui:VisualElement
                    class="campaign-opening-panel__portrait-frame"
                    picking-mode="Ignore">
                    <ui:VisualElement
                        class="campaign-opening-panel__portrait"
                        picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement
                    class="campaign-opening-panel__content"
                    picking-mode="Position">

                    <ui:VisualElement
                        class="campaign-opening-panel__header"
                        picking-mode="Ignore">
                        <ui:Label
                            name="campaign-opening-speaker"
                            text="MILTON BIG"
                            class="campaign-opening-panel__speaker"
                            picking-mode="Ignore" />
                        <ui:Label
                            name="campaign-opening-progress"
                            text="1 / 3"
                            class="campaign-opening-panel__progress"
                            picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:Label
                        name="campaign-opening-dialogue"
                        text="There she is."
                        class="campaign-opening-panel__dialogue"
                        picking-mode="Ignore" />

                    <ui:VisualElement
                        class="campaign-opening-panel__actions"
                        picking-mode="Position">
                        <ui:Button
                            name="campaign-opening-skip"
                            text="Skip Introduction"
                            class="campaign-opening-panel__button campaign-opening-panel__button--secondary" />
                        <ui:Button
                            name="campaign-opening-continue"
                            text="Continue"
                            class="campaign-opening-panel__button campaign-opening-panel__button--primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="control-hint"
            class="control-hint"
            picking-mode="Ignore">

            <ui:Label
                text="CONTROL"
                class="control-hint__caption"
                picking-mode="Ignore" />

            <ui:Label
                name="control-hint-title"
                text="Foundations"
                class="control-hint__title"
                picking-mode="Ignore" />

            <ui:Label
                name="control-hint-description"
                text="Build foundations or sidewalks."
                class="control-hint__description"
                picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
