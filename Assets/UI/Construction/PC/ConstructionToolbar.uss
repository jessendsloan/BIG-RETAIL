}

.campaign-opening-panel__portrait {
    flex-grow: 1;
    background-image: url("project://database/Assets/Art/Campaign/MiltonBig.png");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 4px;
}

.campaign-opening-panel__content {
    flex-grow: 1;
    flex-direction: column;
}

.campaign-opening-panel__header {
    min-height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
