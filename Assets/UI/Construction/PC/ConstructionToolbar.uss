}

.campaign-opening-overlay {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding-top: 24px;
    align-items: center;
    background-color: rgba(13, 18, 20, 0.20);
}

.campaign-opening-panel {
    width: 1020px;
    min-height: 270px;
    padding: 18px;
    flex-direction: row;
    background-color: rgba(42, 50, 53, 0.98);
    border-width: 2px;
    border-color: rgb(181, 137, 61);
    border-radius: 12px;
}

.campaign-opening-panel__portrait-frame {
    width: 220px;
    height: 220px;
    margin-right: 20px;
    padding: 4px;
