.construction-toolbar-screen {
    flex-grow: 1;
    position: relative;
    font-size: 18px;
}

.store-cash-hud {
    position: absolute;
    bottom: 24px;
    left: 24px;
    width: 240px;
    min-height: 82px;
    padding-top: 7px;
    padding-right: 14px;
    padding-bottom: 7px;
    padding-left: 14px;
    flex-direction: column;
    justify-content: center;
    background-color: rgba(244, 240, 230, 0.96);
    border-width: 2px;
    border-left-width: 6px;
    border-color: rgba(35, 43, 50, 0.24);
    border-left-color: rgb(74, 112, 91);
    border-radius: 10px;
}

.store-cash-hud__caption {
    min-height: 22px;
    color: rgb(95, 99, 96);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 1px;
}

.store-cash-hud__value {
    min-height: 34px;
    color: rgb(35, 54, 44);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.simulation-clock {
    position: absolute;
    bottom: 24px;
    left: 50%;
    margin-left: -260px;
    width: 520px;
    min-height: 82px;
    flex-direction: row;
    align-items: stretch;
    padding: 7px;
    background-color: rgba(244, 240, 230, 0.96);
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.30);
    border-radius: 10px;
}

.simulation-clock__readout {
    width: 236px;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
    padding-left: 8px;
    border-right-width: 1px;
    border-right-color: rgba(35, 43, 50, 0.18);
}

.simulation-clock__day {
    min-height: 24px;
    color: rgb(62, 70, 75);
    font-size: 18px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.fixture-merchandising-inspector {
    display: none;
    position: absolute;
    top: 18px;
    right: 18px;
    bottom: 18px;
    width: 560px;
    padding: 20px;
    flex-direction: column;
    background-color: rgba(248, 245, 237, 0.98);
    border-width: 2px;
    border-color: rgba(35, 43, 50, 0.34);
    border-radius: 14px;
}

.fixture-merchandising-inspector__header {
    min-height: 64px;
    margin-top: -20px;
    margin-right: -20px;
    margin-bottom: 14px;
    margin-left: -20px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(54, 66, 72);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

.fixture-merchandising-inspector__title {
    flex-grow: 1;
    min-height: 36px;
    color: rgb(249, 247, 241);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.fixture-merchandising-inspector__close-button {
    width: 44px;
    height: 44px;
    padding: 0;
    color: rgb(249, 247, 241);
    font-size: 26px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
}

.fixture-merchandising-inspector__close-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.fixture-merchandising-inspector__status {
    min-height: 56px;
    margin-top: 0;
    margin-bottom: 13px;
    padding-top: 9px;
    padding-right: 11px;
    padding-bottom: 9px;
    padding-left: 12px;
    color: rgb(64, 70, 74);
    font-size: 18px;
    white-space: normal;
    background-color: rgba(255, 255, 255, 0.62);
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(73, 103, 113, 0.28);
    border-left-color: rgb(81, 116, 126);
    border-radius: 7px;
}

.fixture-merchandising-inspector__status--error {
    color: rgb(164, 42, 36);
    border-left-color: rgb(180, 65, 54);
}

.fixture-merchandising-inspector__overview {
    flex-direction: column;
}

.fixture-merchandising-inspector__storage-overview {
    display: none;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
}

.fixture-merchandising-inspector__storage-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-right: 5px;
}

.fixture-merchandising-inspector__subtitle {
    margin-bottom: 10px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
    color: rgb(82, 86, 88);
    font-size: 20px;
    background-color: rgba(76, 108, 119, 0.09);
    border-width: 1px;
    border-color: rgba(76, 108, 119, 0.18);
    border-radius: 6px;
}

.fixture-merchandising-inspector__preview-badge {
    min-height: 34px;
    margin-bottom: 13px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgb(111, 77, 20);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(228, 191, 103, 0.22);
    border-width: 1px;
    border-color: rgba(143, 103, 31, 0.28);
    border-radius: 5px;
}

.fixture-merchandising-inspector__storage-note {
    min-height: 72px;
    margin-bottom: 13px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    color: rgb(64, 70, 74);
    font-size: 17px;
    white-space: normal;
    background-color: rgba(255, 255, 255, 0.62);
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(73, 103, 113, 0.24);
    border-left-color: rgb(81, 116, 126);
    border-radius: 7px;
}

.fixture-merchandising-inspector__storage-status--warning {
    color: rgb(164, 42, 36);
}

.fixture-merchandising-inspector__storage-contents {
    min-height: 48px;
    margin-bottom: 2px;
    padding-top: 7px;
    padding-right: 10px;
    padding-bottom: 7px;
    padding-left: 10px;
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.72);
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.18);
    border-radius: 7px;
}

.fixture-merchandising-inspector__storage-content-row {
    min-height: 36px;
    padding-left: 9px;
    padding-right: 9px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-left-width: 5px;
    border-left-color: rgb(81, 116, 126);
}

.fixture-merchandising-inspector__storage-content-name {
    color: rgb(64, 70, 74);
    font-size: 17px;
}

.fixture-merchandising-inspector__storage-content-quantity {
    color: rgb(51, 64, 69);
    font-size: 17px;
    -unity-font-style: bold;
}

.fixture-merchandising-inspector__storage-empty {
    min-height: 36px;
    color: rgb(74, 80, 83);
    font-size: 17px;
    -unity-text-align: middle-center;
}

.fixture-merchandising-inspector__purchasing {
    margin-top: 12px;
    padding-top: 10px;
    padding-right: 11px;
    padding-bottom: 11px;
    padding-left: 11px;
    flex-direction: column;
    background-color: rgba(228, 191, 103, 0.10);
    border-width: 1px;
    border-color: rgba(143, 103, 31, 0.22);
    border-radius: 9px;
}

.fixture-merchandising-inspector__purchasing-note {
    min-height: 62px;
    margin-bottom: 9px;
    color: rgb(74, 72, 66);
    font-size: 17px;
    white-space: normal;
}

.fixture-merchandising-inspector__purchasing-products {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -6px;
    margin-bottom: 4px;
}

.fixture-merchandising-inspector__purchase-button {
    width: 250px;
    min-height: 52px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 9px;
    padding-right: 7px;
    color: rgb(35, 43, 50);
    font-size: 17px;
    background-color: rgba(250, 249, 245, 0.96);
    border-width: 1px;
    border-left-width: 6px;
    border-color: rgba(35, 43, 50, 0.18);
    border-radius: 6px;
}

.fixture-merchandising-inspector__purchase-button:hover {
    background-color: rgba(228, 191, 103, 0.26);
}

.fixture-merchandising-inspector__purchasing-summary {
    min-height: 40px;
    margin-bottom: 7px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.54);
    border-radius: 6px;
}

.fixture-merchandising-inspector__purchasing-summary--cash {
    margin-bottom: 9px;
    background-color: rgba(82, 113, 83, 0.11);
    border-left-width: 5px;
    border-left-color: rgb(73, 113, 75);
}

.fixture-merchandising-inspector__summary-value--cash {
    color: rgb(49, 91, 53);
    font-size: 22px;
}

.fixture-merchandising-inspector__receive-button {
    min-height: 54px;
    color: rgb(249, 247, 241);
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgb(69, 84, 91);
    border-width: 1px;
    border-color: rgb(52, 64, 69);
    border-radius: 6px;
}

.fixture-merchandising-inspector__receive-button:hover {
    background-color: rgb(81, 98, 106);
}

.fixture-merchandising-inspector__purchasing-status {
    min-height: 38px;
    margin-top: 6px;
    color: rgb(82, 86, 88);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.fixture-merchandising-inspector__summary {
    margin-bottom: 11px;
    padding-top: 10px;
    padding-right: 13px;
    padding-bottom: 10px;
    padding-left: 13px;
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.72);
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.18);
    border-radius: 9px;
}

.fixture-merchandising-inspector__summary-row {
    min-height: 40px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(35, 43, 50, 0.08);
}

.fixture-merchandising-inspector__summary-row--live {
    background-color: rgba(82, 113, 83, 0.09);
}

.fixture-merchandising-inspector__summary-label,
.fixture-merchandising-inspector__summary-value {
    color: rgb(52, 58, 62);
    font-size: 17px;
}

.fixture-merchandising-inspector__summary-label {
    width: 200px;
}

.fixture-merchandising-inspector__summary-value {
    flex-grow: 1;
    -unity-font-style: bold;
}

.fixture-merchandising-inspector__summary-value--pending {
    color: rgb(126, 89, 27);
}

.fixture-merchandising-inspector__summary-value--live {
    color: rgb(58, 96, 61);
}

.fixture-merchandising-inspector__action-row {
    flex-direction: row;
    margin-left: -3px;
    margin-right: -3px;
}

.fixture-merchandising-inspector__action-button {
    flex-grow: 1;
    margin-left: 3px;
    margin-right: 3px;
}

.fixture-merchandising-inspector__debug-button {
    display: none;
    min-height: 44px;
    margin-top: 8px;
    color: rgb(106, 76, 26);
    font-size: 16px;
    background-color: rgba(228, 191, 103, 0.16);
    border-width: 1px;
    border-color: rgba(143, 103, 31, 0.24);
    border-radius: 6px;
}

.fixture-merchandising-inspector__debug-button:hover {
    background-color: rgba(228, 191, 103, 0.28);
}

.fixture-merchandising-inspector__automation-row {
    min-height: 82px;
    margin-top: 12px;
    padding-top: 9px;
    padding-right: 10px;
    padding-bottom: 9px;
    padding-left: 13px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(76, 108, 119, 0.10);
    border-width: 1px;
    border-color: rgba(76, 108, 119, 0.18);
    border-radius: 9px;
}

.fixture-merchandising-inspector__automation-copy {
    flex-grow: 1;
    flex-direction: column;
}

.fixture-merchandising-inspector__automation-title {
    color: rgb(35, 43, 50);
    font-size: 18px;
    -unity-font-style: bold;
}

.fixture-merchandising-inspector__automation-note {
    margin-top: 3px;
    color: rgb(91, 96, 99);
    font-size: 16px;
}

.fixture-merchandising-inspector__automation-button {
    width: 170px;
    min-height: 50px;
    margin-left: 10px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 16px;
    color: rgb(68, 74, 78);
    background-color: rgba(255, 255, 255, 0.68);
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.20);
    border-radius: 6px;
}

.fixture-merchandising-inspector__editing,
.fixture-merchandising-inspector__frontage-controls {
    display: none;
    flex-direction: column;
}

.fixture-merchandising-inspector__shelf-label {
    min-height: 44px;
    margin-bottom: 9px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 12px;
    color: rgb(35, 43, 50);
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgba(76, 108, 119, 0.12);
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(76, 108, 119, 0.20);
    border-left-color: rgb(81, 116, 126);
    border-radius: 7px;
}

.fixture-merchandising-inspector__color-legend {
    min-height: 38px;
    margin-top: 0;
    margin-bottom: 10px;
    padding-top: 5px;
    padding-right: 9px;
    padding-bottom: 5px;
    padding-left: 9px;
    color: rgb(82, 86, 88);
    font-size: 16px;
    -unity-text-align: middle-left;
    background-color: rgba(228, 191, 103, 0.16);
    border-width: 1px;
    border-color: rgba(143, 103, 31, 0.20);
    border-radius: 6px;
}

.fixture-merchandising-inspector__frontage-controls {
    margin-bottom: 10px;
    padding-top: 14px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    background-color: rgba(255, 255, 255, 0.68);
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.18);
    border-radius: 9px;
}

.fixture-merchandising-inspector__products {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.fixture-merchandising-inspector__product-button {
    width: 170px;
    min-height: 56px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 7px;
    color: rgb(35, 43, 50);
    font-size: 17px;
    background-color: rgba(250, 249, 245, 0.96);
    border-width: 1px;
    border-left-width: 6px;
    border-color: rgba(35, 43, 50, 0.18);
    border-radius: 6px;
}

.fixture-merchandising-inspector__product-button:hover,
.fixture-merchandising-inspector__product-button.is-selected {
    background-color: rgba(76, 108, 119, 0.14);
}

.fixture-merchandising-inspector__product-button.is-selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.fixture-merchandising-inspector__width-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
    background-color: rgba(76, 108, 119, 0.08);
    border-radius: 7px;
}

.fixture-merchandising-inspector__step-button {
    width: 52px;
    height: 50px;
    padding: 0;
    color: rgb(249, 247, 241);
    font-size: 26px;
    background-color: rgb(69, 84, 91);
    border-width: 1px;
    border-color: rgb(52, 64, 69);
    border-radius: 6px;
}

.fixture-merchandising-inspector__width-label {
    flex-grow: 1;
    min-height: 50px;
    margin-left: 10px;
    margin-right: 10px;
    color: rgb(35, 43, 50);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.fixture-merchandising-inspector__primary-button,
.fixture-merchandising-inspector__secondary-button {
    min-height: 56px;
    margin-top: 7px;
    color: rgb(35, 43, 50);
    font-size: 18px;
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.24);
    border-radius: 7px;
}

.fixture-merchandising-inspector__primary-button {
    color: rgb(249, 247, 241);
    background-color: rgb(67, 86, 91);
    border-color: rgb(49, 65, 69);
}

.fixture-merchandising-inspector__secondary-button {
    background-color: rgba(255, 255, 255, 0.82);
}

.fixture-merchandising-inspector__primary-button:hover {
    background-color: rgb(79, 101, 107);
}

.fixture-merchandising-inspector__secondary-button:hover,
.fixture-merchandising-inspector__step-button:hover {
    background-color: rgba(76, 108, 119, 0.17);
}

.fixture-merchandising-inspector__step-button:hover {
    color: rgb(35, 43, 50);
}

.fixture-merchandising-inspector__primary-button:disabled,
.fixture-merchandising-inspector__secondary-button:disabled,
.fixture-merchandising-inspector__automation-button:disabled {
    opacity: 0.62;
}

.simulation-clock__time {
    min-height: 34px;
    color: rgb(35, 43, 50);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.simulation-clock__speeds {
    width: 240px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-left: 8px;
}

.simulation-clock__speed {
    width: 48px;
    height: 52px;
    margin-left: 1px;
    margin-right: 1px;
    padding: 0;
    color: rgba(35, 43, 50, 0.76);
    font-size: 18px;
    background-color: rgba(255, 255, 255, 0.48);
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.14);
    border-radius: 6px;
}

.simulation-clock__speed:hover {
    background-color: rgba(54, 63, 69, 0.10);
}

.simulation-clock__speed:active {
    background-color: rgba(54, 63, 69, 0.18);
}

.simulation-clock__speed.is-selected {
    color: rgb(255, 255, 255);
    background-color: rgb(64, 83, 90);
    border-width: 2px;
    border-color: rgb(45, 58, 63);
}

.finish-picker {
    display: none;
    position: absolute;
    left: 104px;
    min-width: 330px;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-color: rgb(244, 240, 230);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 0;
    border-left-width: 1px;
    border-top-color: rgba(35, 43, 50, 0.24);
    border-right-color: rgba(35, 43, 50, 0.24);
    border-left-color: rgba(35, 43, 50, 0.24);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.department-picker {
    display: none;
    position: absolute;
    top: 24px;
    left: 104px;
    min-width: 330px;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-color: rgb(244, 240, 230);
    border-width: 1px;
    border-color: rgba(35, 43, 50, 0.24);
    border-radius: 10px;
}

.department-picker__title {
    min-height: 28px;
    margin-bottom: 5px;
    color: rgb(35, 43, 50);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.department-picker__items {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.department-picker__button {
    width: 92px;
    height: 106px;
    margin-left: 4px;
    margin-right: 4px;
    padding: 3px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.46);
    border-width: 2px;
    border-color: rgba(35, 43, 50, 0.16);
    border-radius: 8px;
}

.department-picker__button:hover {
    background-color: rgba(54, 63, 69, 0.12);
}

.department-picker__button:active,
.department-picker__button.is-selected {
    background-color: rgba(54, 63, 69, 0.20);
}

.department-picker__button.is-selected {
    border-width: 3px;
    border-color: rgb(35, 43, 50);
}

.department-picker__icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.department-picker__label {
    min-height: 32px;
    margin-top: 3px;
    flex-shrink: 0;
    color: rgb(35, 43, 50);
    font-size: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}

#foundation-picker {
    top: 100px;
}

#floor-finish-picker {
    top: 172px;
}

#wall-finish-picker {
    top: 244px;
}

#door-definition-picker {
    top: 316px;
}

#fixture-definition-picker {
    top: 388px;
}

.fixture-picker__content {
    flex-direction: row;
    align-items: center;
}

.fixture-picker__rotate-button {
    width: 48px;
    height: 48px;
    margin-left: 8px;
    padding: 0;
    color: rgb(35, 43, 50);
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.46);
    border-width: 2px;
