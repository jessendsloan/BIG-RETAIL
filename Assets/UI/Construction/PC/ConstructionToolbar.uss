    border-width: 1px;
    border-color: rgb(239, 209, 145);
}

.campaign-opening-panel__button--primary:hover {
    background-color: rgb(230, 194, 116);
}

/* A fixed information dock keeps hover and focus context out of tool panels. */
.control-hint {
    position: absolute;
    bottom: 118px;
    left: 24px;
    width: 440px;
    min-height: 90px;
    padding-top: 9px;
    padding-right: 16px;
    padding-bottom: 11px;
    padding-left: 17px;
    flex-direction: column;
    opacity: 0;
    translate: 0 7px;
    background-color: rgba(31, 42, 47, 0.98);
    border-width: 2px;
    border-left-width: 7px;
    border-color: rgb(16, 27, 31);
    border-left-color: rgb(224, 178, 84);
    border-radius: 10px;
    transition-property: opacity, translate;
    transition-duration: 90ms, 120ms;
    transition-timing-function: ease-out;
}

.control-hint.is-visible {
    opacity: 1;
    translate: 0 0;
}

.control-hint__caption {
    min-height: 18px;
    color: rgb(234, 198, 123);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.control-hint__title {
    min-height: 26px;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.control-hint__description {
    min-height: 32px;
    color: rgb(232, 237, 238);
    font-size: 17px;
    white-space: normal;
}

/* A clear, non-color-only interaction state for every gameplay control. */
.construction-toolbar__button,
.finish-picker__button,
.wall-finish-picker__button,
.demolition-picker__button,
.department-picker__button,
.fixture-picker__rotate-button,
.camera-rotation-controls__button,
.wall-view-controls__button,
.simulation-clock__speed,
.fixture-merchandising-inspector__close-button,
.fixture-merchandising-inspector__purchase-button,
.fixture-merchandising-inspector__receive-button,
.fixture-merchandising-inspector__product-button,
.fixture-merchandising-inspector__step-button,
.fixture-merchandising-inspector__primary-button,
.fixture-merchandising-inspector__secondary-button,
.fixture-merchandising-inspector__automation-button,
.campaign-opening-panel__button {
    transition-property: background-color, border-color, scale;
    transition-duration: 90ms, 90ms, 120ms;
    transition-timing-function: ease-out;
}

.construction-toolbar__button:hover,
.finish-picker__button:hover,
.wall-finish-picker__button:hover,
.demolition-picker__button:hover,
.department-picker__button:hover,
.fixture-picker__rotate-button:hover,
.camera-rotation-controls__button:hover,
.wall-view-controls__button:hover,
.simulation-clock__speed:hover {
    scale: 1.06 1.06;
    background-color: rgba(24, 88, 99, 0.18);
}

.construction-toolbar__button:focus,
.merchandise-tool-button:focus,
.finish-picker__button:focus,
.wall-finish-picker__button:focus,
.demolition-picker__button:focus,
.department-picker__button:focus,
.fixture-picker__rotate-button:focus,
.camera-rotation-controls__button:focus,
.wall-view-controls__button:focus,
.simulation-clock__speed:focus,
.fixture-merchandising-inspector__close-button:focus,
.fixture-merchandising-inspector__purchase-button:focus,
.fixture-merchandising-inspector__receive-button:focus,
.fixture-merchandising-inspector__product-button:focus,
.fixture-merchandising-inspector__step-button:focus,
.fixture-merchandising-inspector__primary-button:focus,
.fixture-merchandising-inspector__secondary-button:focus,
.fixture-merchandising-inspector__automation-button:focus,
.campaign-opening-panel__button:focus {
    scale: 1.06 1.06;
    background-color: rgba(24, 88, 99, 0.24);
    border-width: 3px;
    border-color: rgb(13, 77, 89);
}

.construction-toolbar__button:focus,
.merchandise-tool-button:focus,
.finish-picker__button:focus,
.wall-finish-picker__button:focus,
.demolition-picker__button:focus,
.department-picker__button:focus,
.fixture-picker__rotate-button:focus,
.camera-rotation-controls__button:focus,
.wall-view-controls__button:focus,
.simulation-clock__speed:focus {
    color: rgb(35, 43, 50);
    background-color: rgb(244, 240, 230);
}

.simulation-clock__speed.is-selected:focus {
    color: rgb(255, 255, 255);
    background-color: rgb(64, 83, 90);
    border-color: rgb(234, 190, 103);
}

.fixture-merchandising-inspector__close-button:focus,
.fixture-merchandising-inspector__receive-button:focus,
.fixture-merchandising-inspector__step-button:focus,
.fixture-merchandising-inspector__primary-button:focus,
.campaign-opening-panel__button--secondary:focus {
    color: rgb(255, 255, 255);
    background-color: rgb(54, 66, 72);
    border-color: rgb(234, 190, 103);
}

.campaign-opening-panel__button--primary:focus {
    color: rgb(32, 35, 33);
    background-color: rgb(230, 194, 116);
    border-color: rgb(18, 75, 85);
}

.construction-toolbar__button:active,
.finish-picker__button:active,
.wall-finish-picker__button:active,
.demolition-picker__button:active,
.department-picker__button:active,
.fixture-picker__rotate-button:active,
.camera-rotation-controls__button:active,
.wall-view-controls__button:active,
.simulation-clock__speed:active {
    scale: 0.96 0.96;
}

/* This root class is the integration seam for the accessibility settings
   screen: it removes all decorative transition motion without changing state. */
.construction-toolbar-screen.is-reduced-motion .control-hint,
.construction-toolbar-screen.is-reduced-motion .construction-toolbar__button,
.construction-toolbar-screen.is-reduced-motion .finish-picker__button,
.construction-toolbar-screen.is-reduced-motion .wall-finish-picker__button,
.construction-toolbar-screen.is-reduced-motion .demolition-picker__button,
.construction-toolbar-screen.is-reduced-motion .department-picker__button,
.construction-toolbar-screen.is-reduced-motion .fixture-picker__rotate-button,
.construction-toolbar-screen.is-reduced-motion .camera-rotation-controls__button,
.construction-toolbar-screen.is-reduced-motion .wall-view-controls__button,
.construction-toolbar-screen.is-reduced-motion .simulation-clock__speed {
    transition-duration: 0ms;
}
