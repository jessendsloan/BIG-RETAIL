.construction-toolbar-screen {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: stretch;
}

.construction-toolbar {
    height: 92px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding-top: 10px;
    padding-right: 24px;
    padding-bottom: 12px;
    padding-left: 24px;
    background-color: rgb(244, 240, 230);
    border-top-width: 1px;
    border-top-color: rgba(35, 43, 50, 0.22);
}

.construction-toolbar__group {
    flex-direction: row;
    align-items: center;
}

.construction-toolbar__button {
    width: 72px;
    height: 64px;
    margin-left: 4px;
    margin-right: 4px;
    padding: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(35, 43, 50, 0);
    border-right-color: rgba(35, 43, 50, 0);
    border-bottom-color: rgba(35, 43, 50, 0);
    border-left-color: rgba(35, 43, 50, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.construction-toolbar__button:hover {
    background-color: rgba(54, 63, 69, 0.08);
}

.construction-toolbar__button:active {
    background-color: rgba(54, 63, 69, 0.16);
}

.construction-toolbar__button:focus {
    border-top-color: rgb(35, 43, 50);
    border-right-color: rgb(35, 43, 50);
    border-bottom-color: rgb(35, 43, 50);
    border-left-color: rgb(35, 43, 50);
}

.construction-toolbar__button.is-selected {
    background-color: rgba(54, 63, 69, 0.18);
    border-top-color: rgba(35, 43, 50, 0.42);
    border-right-color: rgba(35, 43, 50, 0.42);
    border-bottom-color: rgba(35, 43, 50, 0.42);
    border-left-color: rgba(35, 43, 50, 0.42);
}

.construction-toolbar__button:disabled {
    opacity: 0.32;
}

.construction-toolbar__button--history {
    width: 64px;
}

.construction-toolbar__separator {
    width: 1px;
    height: 46px;
    margin-left: 12px;
    margin-right: 12px;
    background-color: rgba(35, 43, 50, 0.20);
}

.construction-toolbar__icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
}

.construction-toolbar__icon--walls {
    background-image: url("project://database/Assets/Art/UI/Construction/Icons/Icon_Walls.png");
}

.construction-toolbar__icon--wallpaper {
    background-image: url("project://database/Assets/Art/UI/Construction/Icons/Icon_Wallpaper.png");
}

.construction-toolbar__icon--floors {
    background-image: url("project://database/Assets/Art/UI/Construction/Icons/Icon_Floors.png");
}

.construction-toolbar__icon--demolition {
    background-image: url("project://database/Assets/Art/UI/Construction/Icons/Icon_Demolition.png");
}

.construction-toolbar__icon--undo {
    background-image: url("project://database/Assets/Art/UI/Construction/Icons/Icon_Undo.png");
}

.construction-toolbar__icon--redo {
    background-image: url("project://database/Assets/Art/UI/Construction/Icons/Icon_Redo.png");
}
